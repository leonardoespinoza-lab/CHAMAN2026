{
  "name": "chaman2026",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo local para CHAMAN Agro 2026: plataforma agronomica, sensores, clima, predicciones y gestion multi-tenant.",
  "engines": {
    "node": ">=20 <21",
    "npm": ">=10"
  },
  "scripts": {
    "build": "npm run build:datos && npm run build:auth && npm run build:api-cliente && npm run build:predicciones && npm run build:clima && npm run build:lora && npm run build:app",
    "build:datos": "npm --prefix sdc-datos run build",
    "build:auth": "npm --prefix sdc-auth run build",
    "build:api-cliente": "npm --prefix sdc-api-cliente run build",
    "build:predicciones": "npm --prefix sdc-api-predicciones run build",
    "build:clima": "npm --prefix sdc-api-clima run build",
    "build:lora": "npm --prefix sdc-api-lora run build",
    "build:ftp": "npm --prefix sdc-ftp run build",
    "build:app": "npm --prefix sdc-app-chaman run build-test",
    "start:local": "powershell -ExecutionPolicy Bypass -File scripts/start-local-services.ps1",
    "stop:local": "powershell -ExecutionPolicy Bypass -File scripts/stop-local-services.ps1",
    "seed:admin": "node scripts/seed-admin-local.js",
    "seed:master-data": "node scripts/seed-master-data-local.js",
    "seed:agro-inputs": "node scripts/seed-agro-inputs-local.js",
    "seed:expanded-crops": "node scripts/seed-expanded-crops-local.js",
    "seed:cebada": "node scripts/seed-cebada-local.js",
    "seed:kleppe-frutales": "node scripts/seed-kleppe-frutales-local.js",
    "seed:weeds": "node scripts/seed-weeds-gompertz-local.js",
    "seed:demo": "node scripts/seed-demo-hierarchy-local.js",
    "import:legacy-frutales": "node scripts/import-legacy-frutales.js",
    "import:suelos-inta": "npm --prefix sdc-datos run import:suelos-inta",
    "audit:secrets": "node scripts/audit-config-secrets.js",
    "audit:logs": "node scripts/audit-sensitive-logs.js",
    "audit:prod-config": "node scripts/validate-production-config.js",
    "audit:deployment-topology": "node scripts/validate-deployment-topology.js",
    "audit:lote-integrity": "node scripts/audit-lote-data-integrity.js",
    "railway:build": "node scripts/railway-build.js",
    "railway:start": "node scripts/railway-start.js"
  },
  "dependencies": {
    "modelos": "file:sdc-modelos"
  }
}
