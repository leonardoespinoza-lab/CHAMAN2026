{
  "name": "chaman2026",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo local para CHAMAN Agro 2026: plataforma agronomica, sensores, clima, predicciones y gestion multi-tenant.",
  "engines": {
    "node": ">=20 <21",
    "npm": ">=10"
  },
  "scripts": {
    "build": "npm run build:datos && npm run build:auth && npm run build:api-cliente && npm run build:predicciones && npm run build:clima && npm run build:lora && npm run build:meteo-worker && npm run build:app",
    "build:datos": "npm --prefix sdc-datos run build",
    "build:auth": "npm --prefix sdc-auth run build",
    "build:api-cliente": "npm --prefix sdc-api-cliente run build",
    "build:predicciones": "npm --prefix sdc-api-predicciones run build",
    "build:clima": "npm --prefix sdc-api-clima run build",
    "build:lora": "npm --prefix sdc-api-lora run build",
    "build:ftp": "npm --prefix sdc-ftp run build",
    "build:meteo-worker": "python -m py_compile sdc-meteo-worker/worker.py sdc-meteo-worker/cds_client.py sdc-meteo-worker/calculations.py sdc-meteo-worker/config.py sdc-meteo-worker/health.py",
    "build:app": "npm --prefix sdc-app-chaman run build-test",
    "start:local": "powershell -ExecutionPolicy Bypass -File scripts/start-local-services.ps1",
    "stop:local": "powershell -ExecutionPolicy Bypass -File scripts/stop-local-services.ps1",
    "seed:admin": "node scripts/seed-admin-local.js",
    "seed:master-data": "node scripts/seed-master-data-local.js",
    "seed:agro-inputs": "node scripts/seed-agro-inputs-local.js",
    "seed:expanded-crops": "node scripts/seed-expanded-crops-local.js",
    "seed:cebada": "node scripts/seed-cebada-local.js",
    "migrate:sanitary:plan": "node scripts/migrations/20260712-sanitary-matrix.js plan",
    "migrate:sanitary:apply": "node scripts/migrations/20260712-sanitary-matrix.js apply",
    "migrate:sanitary:rollback": "node scripts/migrations/20260712-sanitary-matrix.js rollback",
    "migrate:soja-recso:plan": "node scripts/migrations/20260712-soja-recso-matrix-v2.js plan",
    "migrate:soja-recso:apply": "node scripts/migrations/20260712-soja-recso-matrix-v2.js apply",
    "migrate:soja-recso:rollback": "node scripts/migrations/20260712-soja-recso-matrix-v2.js rollback",
    "migrate:agromet:plan": "node scripts/migrations/20260713-agrometeorology-engine.js plan",
    "migrate:agromet:apply": "node scripts/migrations/20260713-agrometeorology-engine.js apply",
    "migrate:agromet:rollback": "node scripts/migrations/20260713-agrometeorology-engine.js rollback",
    "migrate:lot-location:plan": "node scripts/migrations/20260714-lot-administrative-location.js plan",
    "migrate:lot-location:apply": "node scripts/migrations/20260714-lot-administrative-location.js apply",
    "migrate:lot-location:rollback": "node scripts/migrations/20260714-lot-administrative-location.js rollback",
    "migrate:establishment-location:plan": "node scripts/migrations/20260714-establishment-location-automation.js plan",
    "migrate:establishment-location:apply": "node scripts/migrations/20260714-establishment-location-automation.js apply",
    "migrate:establishment-location:rollback": "node scripts/migrations/20260714-establishment-location-automation.js rollback",
    "migrate:soil-intelligence:plan": "node scripts/migrations/20260714-soil-intelligence.js plan",
    "migrate:soil-intelligence:apply": "node scripts/migrations/20260714-soil-intelligence.js apply",
    "migrate:soil-intelligence:rollback": "node scripts/migrations/20260714-soil-intelligence.js rollback",
    "migrate:active-indexes:plan": "node scripts/migrations/20260723-active-unique-indexes.js plan",
    "migrate:active-indexes:apply": "node scripts/migrations/20260723-active-unique-indexes.js apply",
    "migrate:active-indexes:rollback": "node scripts/migrations/20260723-active-unique-indexes.js rollback",
    "migrate:chaman-meteo:plan": "node scripts/migrations/20260827-chaman-meteo-foundation.js plan",
    "migrate:chaman-meteo:apply": "node scripts/migrations/20260827-chaman-meteo-foundation.js apply",
    "migrate:chaman-meteo:rollback": "node scripts/migrations/20260827-chaman-meteo-foundation.js rollback",
    "migrate:chaman-meteo-v2-indexes:plan": "node scripts/migrations/20260828-chaman-meteo-v2-read-indexes.js plan",
    "migrate:chaman-meteo-v2-indexes:apply": "node scripts/migrations/20260828-chaman-meteo-v2-read-indexes.js apply",
    "migrate:chaman-meteo-v2-indexes:rollback": "node scripts/migrations/20260828-chaman-meteo-v2-read-indexes.js rollback",
    "test:chaman-meteo-v2-indexes": "node --test scripts/tests/chaman-meteo-v2-read-indexes-migration.test.js",
    "test:active-indexes-migration": "node --test scripts/tests/active-unique-indexes-migration.test.js",
    "migrate:cold-metadata:plan": "node scripts/migrations/20260716-cold-metadata-normalization.js plan",
    "migrate:cold-metadata:apply": "node scripts/migrations/20260716-cold-metadata-normalization.js apply",
    "migrate:cold-metadata:rollback": "node scripts/migrations/20260716-cold-metadata-normalization.js rollback",
    "test:cold-metadata-migration": "node --test scripts/tests/cold-metadata-migration.test.js",
    "migrate:notification-outbox:plan": "node scripts/migrations/20260716-notification-eventkey-outbox.js plan",
    "migrate:notification-outbox:apply": "node scripts/migrations/20260716-notification-eventkey-outbox.js apply",
    "migrate:notification-outbox:rollback": "node scripts/migrations/20260716-notification-eventkey-outbox.js rollback",
    "test:notification-outbox-migration": "node --test scripts/tests/notification-eventkey-migration.test.js",
    "seed:kleppe-frutales": "node scripts/seed-kleppe-frutales-local.js",
    "seed:weeds": "node scripts/seed-weeds-gompertz-local.js",
    "seed:demo": "node scripts/seed-demo-hierarchy-local.js",
    "import:legacy-frutales": "node scripts/import-legacy-frutales.js",
    "import:suelos-inta": "npm --prefix sdc-datos run import:suelos-inta",
    "audit:secrets": "node scripts/audit-config-secrets.js",
    "audit:logs": "node scripts/audit-sensitive-logs.js",
    "audit:prod-config": "node scripts/validate-production-config.js",
    "audit:deployment-topology": "node scripts/validate-deployment-topology.js",
    "audit:lote-integrity": "node scripts/audit-lote-data-integrity.js",
    "test:agromet:frontend": "node --test scripts/tests/agrometeorology-frontend.test.js",
    "test:chaman-meteo": "npm --prefix sdc-api-clima test -- --runInBand src/entidades/chaman-meteo/calculations.spec.ts --silent && cd sdc-meteo-worker && python -m unittest discover -v -p \"test_*.py\"",
    "test:lot-location:frontend": "node --test scripts/tests/lot-location-frontend.test.js",
    "test:establishment-location:frontend": "node --test scripts/tests/establishment-location-frontend.test.js",
    "test:soil-intelligence:frontend": "node --test scripts/tests/soil-intelligence-frontend.test.js",
    "test:varietal-profile:frontend": "node --test scripts/tests/varietal-profile-frontend.test.js",
    "test:visual-language": "node --test scripts/tests/chaman-visual-language.test.mjs",
    "test:load-runner": "node --test scripts/tests/testing-load-smoke.test.mjs",
    "load:testing": "node scripts/tests/testing-load-smoke.mjs --confirm-testing",
    "railway:build": "node scripts/railway-build.js",
    "railway:start": "node scripts/railway-start.js"
  },
  "dependencies": {
    "modelos": "file:sdc-modelos"
  }
}
