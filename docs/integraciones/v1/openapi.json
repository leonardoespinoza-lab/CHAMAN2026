  "components": {
    "securitySchemes": {
      "IntegrationKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "Clave exclusiva del backend del integrador, nunca contraseña de Chamán."
      }
    },
    "schemas": {
      "ProductorInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "nombre": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "nombre"
        ]
      },
      "EstablecimientoInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "nombre": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "productorIdExterno": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "required": [
          "nombre",
          "productorIdExterno"
        ]
      },
      "LoteInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "nombre": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "establecimientoIdExterno": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
            "minLength": 1,
            "maxLength": 80
          },
          "ubicacion": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "lng": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            },
            "required": [
              "lat",
              "lng"
            ]
          },
          "superficieHa": {
            "type": "number",
            "minimum": 0,
            "exclusiveMinimum": true,
            "maximum": 100000
          }
        },
        "required": [
          "nombre",
          "establecimientoIdExterno",
          "ubicacion",
          "superficieHa"
        ]
      },
      "SiembraInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "loteIdExterno": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
            "minLength": 1,
            "maxLength": 80
          },
          "idSemilla": {
            "type": "string",
            "pattern": "^[a-f0-9]{24}$"
          },
          "fechaSiembra": {
            "type": "string",
            "format": "date",
            "description": "2000-01-01 hasta hoy + 366 días; campaña anual."
          }
        },
        "required": [
          "loteIdExterno",
          "idSemilla",
          "fechaSiembra"
        ]
      },
      "Recurso": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "productores",
              "establecimientos",
              "lotes",
              "siembras"
            ]
          },
          "idExterno": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
            "minLength": 1,
            "maxLength": 80
          },
          "estado": {
            "type": "string",
            "enum": [
              "registrado",
              "archivado"
            ]
          },
          "nombre": {
            "type": "string"
          },
          "fechaSiembra": {
            "type": "string",
            "format": "date"
          },
          "activa": {
            "type": "boolean"
          },
          "creado": {
            "type": "boolean",
            "description": "Sólo en respuestas de PUT."
          }
        },
        "required": [
          "tipo",
          "idExterno",
          "estado"
        ]
      },
      "Fenologia": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "siembraIdExterno": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$",
            "minLength": 1,
            "maxLength": 80
          },
          "cultivo": {
            "type": "string",
            "nullable": true
          },
          "variedad": {
            "type": "string",
            "nullable": true
          },
          "fechaSiembra": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "estado": {
            "type": "string",
            "enum": [
              "disponible",
              "pendiente",
              "desactualizada",
              "cosechada"
            ]
          },
          "etapa": {
            "type": "string",
            "nullable": true
          },
          "fechaDato": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "origen": {
            "type": "string",
            "enum": [
              "observada",
              "estimada_con_observacion",
              "estimada_termica",
              "referencia_calendario",
              "referencia_termica",
              "seguimiento",
              "no_disponible"
            ]
          },
          "confirmadaEnCampo": {
            "type": "boolean"
          },
          "confianza": {
            "type": "string",
            "enum": [
              "alta",
              "media",
              "referencia"
            ],
            "nullable": true
          },
          "actualizadoEn": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "consultadoEn": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "siembraIdExterno",
          "cultivo",
          "variedad",
          "fechaSiembra",
          "estado",
          "etapa",
          "fechaDato",
          "origen",
          "confirmadaEnCampo",
          "confianza",
          "actualizadoEn",
          "revision",
          "consultadoEn"
        ]
      },
      "Servicios": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "string"
          },
          "entorno": {
            "type": "string",
            "enum": [
              "testing"
            ]
          },
          "integracion": {
            "type": "string"
          },
          "servicios": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "codigo": {
                  "type": "string"
                },
                "operaciones": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "codigo",
                "operaciones"
              ]
            }
          },
          "permisos": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "solicitudesPorMinuto": {
            "type": "integer"
          },
          "actualizacion": {
            "type": "string",
            "enum": [
              "consulta_periodica"
            ]
          },
          "webhooks": {
            "type": "boolean",
            "enum": [
              false
            ]
          }
        },
        "required": [
          "version",
          "entorno",
          "integracion",
          "servicios",
          "permisos",
          "solicitudesPorMinuto",
          "actualizacion",
          "webhooks"
        ]
      },
      "Catalogo": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "pagina": {
            "type": "integer"
          },
          "limite": {
            "type": "integer"
          },
          "datos": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "idSemilla": {
                  "type": "string"
                },
                "cultivo": {
                  "type": "string"
                },
                "variedad": {
                  "type": "string"
                },
                "ciclo": {
                  "type": "string"
                },
                "semillero": {
                  "type": "string"
                }
              },
              "required": [
                "idSemilla",
                "cultivo"
              ]
            }
          },
          "siguientePagina": {
            "type": "integer",
            "nullable": true
          }
        },
        "required": [
          "pagina",
          "limite",
          "datos",
          "siguientePagina"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
