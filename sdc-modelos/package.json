{
  "name": "modelos",
  "packageManager": "yarn@4.6.0",
  "version": "1.1.1",
  "description": "Modelos para Chamán",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
