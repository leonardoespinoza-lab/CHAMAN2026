* text=auto

*.ts text eol=crlf
*.js text eol=crlf
*.json text eol=crlf
*.md text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.pptx binary
*.xlsx binary
*.docx binary

# Deployment contexts target Linux containers. Fixed LF avoids shell and
# configuration drift between Windows worktrees and Railway images.
deploy/railway/chirpstack/** text eol=lf
scripts/generate-chirpstack-mtls-pki.py text eol=lf
