import { Component, Input, OnChanges, OnDestroy, OnInit, SimpleChanges, ViewEncapsulation } from '@angular/core';
import * as Highcharts from 'highcharts';
import { Subscription } from 'rxjs';
import { IEstablecimiento } from 'modelos/src';
import { ChartComponent } from '../../../../auxiliares/componentes/chart/chart.component';
import { ClimaTraduccionService } from '../../../../auxiliares/servicios/clima-traduccion.service';
import { HelperService } from '../../../../auxiliares/servicios/helper';
import { SharedModule } from '../../../../auxiliares/shared.module';

@Component({
  selector: 'app-drawer-clima',
  imports: [SharedModule, ChartComponent],
  templateUrl: './drawer-clima.component.html',
  styleUrl: './drawer-clima.component.scss',
  encapsulation: ViewEncapsulation.None,
})
export class DrawerClimaComponent implements OnInit, OnDestroy, OnChanges {
  @Input() establecimiento?: IEstablecimiento;
  @Input() visible = false;

  // Datos procesados para la vista
  public climaActual: any = null;
  public prediccionClimatica: any = null;
  public pronosticosDias: any[] = [];

  // Configuración del gráfico
  public chartOptions?: Highcharts.Options;

  // Subscripciones
  private subscripciones: Subscription[] = [];

  constructor(
    private helperService: HelperService,
    private climaTraduccionService: ClimaTraduccionService,
  ) {}

  ngOnInit() {
    if (this.establecimiento) {
      this.cargarDatosClima();
    }
  }

  ngOnDestroy() {
    this.subscripciones.forEach((sub) => sub.unsubscribe());
  }

  ngOnChanges(changes: SimpleChanges) {
    if (changes['establecimiento'] && this.establecimiento) {
      this.cargarDatosClima();
    }
  }

  private cargarDatosClima() {
    if (!this.establecimiento?.id) return;

    console.log('🌤️ Cargando datos de clima para establecimiento:', this.establecimiento.id);

    const subscription = this.helperService
      .obtenerDatos('clima', [
        { field: 'establecimiento', operator: '==', value: this.establecimiento.id },
        { field: 'tipo', operator: '==', value: 'climaActual' },
      ])
      .subscribe({
        next: (resultados) => {
          console.log('🌤️ Datos de clima actuales obtenidos:', resultados);
          this.procesarDatosClima(resultados);
        },
        error: (error) => {
          console.error('❌ Error al cargar datos de clima:', error);
        },
      });

    this.subscripciones.push(subscription);

    const subscriptionPronostico = this.helperService
      .obtenerDatos('clima', [
        { field: 'establecimiento', operator: '==', value: this.establecimiento.id },
        { field: 'tipo', operator: '==', value: 'prediccionClimatica' },
      ])
      .subscribe({
        next: (resultados) => {
          console.log('📈 Datos de pronóstico obtenidos:', resultados);
          this.procesarDatosPronostico(resultados);
        },
        error: (error) => {
          console.error('❌ Error al cargar pronóstico:', error);
        },
      });

    this.subscripciones.push(subscriptionPronostico);
  }

  private procesarDatosClima(datos: any[]) {
    if (datos && datos.length > 0) {
      // Ordenar por fecha descendente para obtener el más reciente
      const datosOrdenados = datos.sort((a, b) => new Date(b.fecha).getTime() - new Date(a.fecha).getTime());
      this.climaActual = datosOrdenados[0];

      console.log('🌤️ Clima actual procesado:', this.climaActual);
    } else {
      console.log('❌ No se encontraron datos de clima actual');
    }
  }

  private procesarDatosPronostico(datos: any[]) {
    if (datos && datos.length > 0) {
      const datosOrdenados = datos.sort((a, b) => new Date(b.fecha).getTime() - new Date(a.fecha).getTime());
      this.prediccionClimatica = datosOrdenados[0];

      console.log('📈 Predicción climática procesada:', this.prediccionClimatica);

      if (this.prediccionClimatica?.clima?.pronosticos && Array.isArray(this.prediccionClimatica.clima.pronosticos)) {
        this.pronosticosDias = [];

        for (const pronostico of this.prediccionClimatica.clima.pronosticos) {
          const tempMax = pronostico.temperatura?.max;
          const tempMin = pronostico.temperatura?.min;
          const humedad = pronostico.humedad?.avg;
          const precipitacion = pronostico.precipitacion?.total || 0;
          const velocidadViento = pronostico.velocidadViento?.avg;
          const iconNum = pronostico.iconNum;

          // Generar descripción basada en los datos
          let descripcion = 'Clima despejado';
          if (precipitacion > 5) {
            descripcion = 'Lluvia moderada';
          } else if (precipitacion > 0) {
            descripcion = 'Lluvia ligera';
          } else if (humedad && humedad > 80) {
            descripcion = 'Nublado';
          }

          const descripcionTraducida = this.climaTraduccionService.traducirDescripcion(descripcion);

          this.pronosticosDias.push({
            fecha: new Date(pronostico.fecha),
            dia: new Date(pronostico.fecha).toLocaleDateString('es', { weekday: 'short' }),
            tempMax: tempMax,
            tempMin: tempMin,
            humedad: humedad,
            precipitacion: precipitacion,
            velocidadViento: velocidadViento,
            iconNum: iconNum,
            summary: descripcionTraducida,
            summaryOriginal: descripcion,
            et0: pronostico.et0,
          });
        }
      }

      console.log('📈 Pronósticos procesados:', this.pronosticosDias);

      // Generar gráfico después de procesar los datos
      this.generarGraficoPronostico();
    } else {
      console.log('❌ No se encontraron pronósticos o estructura inesperada');
    }
  }

  private generarGraficoPronostico() {
    if (this.pronosticosDias.length === 0) return;

    // Preparar datos para el gráfico
    const temperaturasMax = this.pronosticosDias.map((dia) => dia.tempMax || null);
    const temperaturasMin = this.pronosticosDias.map((dia) => dia.tempMin || null);
    const humedades = this.pronosticosDias.map((dia) => dia.humedad || null);
    const precipitaciones = this.pronosticosDias.map((dia) => dia.precipitacion || 0);

    // Generar categorías para el eje X
    const categorias = this.pronosticosDias.map((dia, index) => {
      const today = new Date();
      const dayNames = ['Dom', 'Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb'];
      
      // Si es hoy, mostrar "Hoy", si es mañana "Mañana", sino las 3 letras del día
      if (dia.fecha.toDateString() === today.toDateString()) {
        return 'Hoy';
      } else if (dia.fecha.toDateString() === new Date(today.getTime() + 24 * 60 * 60 * 1000).toDateString()) {
        return 'Mañana';
      } else {
        return dayNames[dia.fecha.getDay()];
      }
    });

    this.chartOptions = {
      chart: {
        type: 'line',
        height: 350,
        width: null, // Usar 100% del ancho del contenedor
        backgroundColor: 'transparent',
        plotBackgroundColor: 'transparent',
        plotBorderWidth: 0,
        plotShadow: false,
        borderWidth: 0,
        style: {
          fontFamily: '"Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif',
        },
        // Márgenes más conservadores para evitar overflow
        marginLeft: 40,
        marginRight: 40,
        marginTop: 20,
        marginBottom: 40,
        spacingTop: 10,
        spacingRight: 5,
        spacingBottom: 15,
        spacingLeft: 5,
        reflow: true,
        animation: false,
      },
      title: {
        text: 'Pronóstico de 7 días',
        style: {
          fontSize: '16px',
          fontWeight: '600',
          color: 'var(--p-text-color)',
        },
        margin: 15,
      },
      subtitle: {
        text: 'Temperatura, humedad y precipitaciones',
        style: {
          color: 'var(--p-text-color-secondary)',
          fontSize: '12px',
        },
      },
      xAxis: {
        categories: categorias,
        labels: {
          style: {
            color: 'var(--p-text-color-secondary)',
            fontSize: '11px',
          },
          rotation: 0,
          align: 'center',
        },
        lineColor: 'var(--p-surface-border)',
        tickColor: 'var(--p-surface-border)',
        gridLineColor: 'var(--p-surface-border)',
        gridLineWidth: 0.5,
        tickLength: 5,
      },
      yAxis: [
        {
          // Eje principal - Temperatura
          title: {
            text: 'Temperatura (°C)',
            style: {
              color: '#e74c3c',
              fontWeight: '600',
              fontSize: '12px',
            },
          },
          labels: {
            style: {
              color: '#e74c3c',
              fontSize: '11px',
            },
          },
          gridLineColor: 'var(--p-surface-border)',
          gridLineWidth: 0.5,
          lineColor: 'var(--p-surface-border)',
          tickColor: 'var(--p-surface-border)',
          opposite: false,
        },
        {
          // Eje secundario - Humedad
          title: {
            text: 'Humedad (%)',
            style: {
              color: '#3498db',
              fontWeight: '600',
              fontSize: '12px',
            },
          },
          labels: {
            style: {
              color: '#3498db',
              fontSize: '11px',
            },
          },
          max: 100,
          min: 0,
          opposite: true,
          gridLineWidth: 0,
          lineColor: 'var(--p-surface-border)',
          tickColor: 'var(--p-surface-border)',
        },
        {
          // Eje terciario - Precipitación
          title: {
            text: 'Precipitación (mm)',
            style: {
              color: '#9b59b6',
              fontWeight: '600',
              fontSize: '12px',
            },
          },
          labels: {
            style: {
              color: '#9b59b6',
              fontSize: '11px',
            },
          },
          opposite: true,
          gridLineWidth: 0,
          lineColor: 'var(--p-surface-border)',
          tickColor: 'var(--p-surface-border)',
          top: '75%',
          height: '25%',
        },
      ],
      tooltip: {
        shared: true,
        backgroundColor: 'var(--p-content-background)',
        borderColor: 'var(--p-surface-border)',
        borderWidth: 1,
        borderRadius: 8,
        shadow: true,
        style: {
          color: 'var(--p-text-color)',
          fontSize: '12px',
        },
        formatter: function () {
          let tooltip = `<strong>${categorias[this.x as number]}</strong><br/>`;

          this.points?.forEach((point) => {
            const color = point.series.color;
            const value = point.y;
            const unit = point.series.name.includes('Temp') ? '°C' : point.series.name.includes('Humedad') ? '%' : 'mm';

            tooltip += `<span style="color:${color}">●</span> ${point.series.name}: <strong>${value}${unit}</strong><br/>`;
          });

          return tooltip;
        },
      },
      legend: {
        enabled: true,
        align: 'center',
        verticalAlign: 'bottom',
        layout: 'horizontal',
        itemStyle: {
          color: 'var(--p-text-color)',
          fontSize: '11px',
          fontWeight: '500',
        },
        itemHoverStyle: {
          color: 'var(--p-text-color)',
        },
        itemHiddenStyle: {
          color: 'var(--p-text-color-secondary)',
        },
        symbolHeight: 12,
        symbolWidth: 12,
        symbolRadius: 6,
        margin: 15,
      },
      series: [
        {
          name: 'Temp. Máxima',
          data: temperaturasMax,
          type: 'areaspline',
          yAxis: 0,
          color: '#e74c3c',
          fillColor: {
            linearGradient: { x1: 0, y1: 0, x2: 0, y2: 1 },
            stops: [
              [0, 'rgba(231, 76, 60, 0.3)'],
              [1, 'rgba(231, 76, 60, 0.1)'],
            ],
          },
          marker: {
            enabled: true,
            radius: 4,
            fillColor: '#e74c3c',
          },
        },
        {
          name: 'Temp. Mínima',
          data: temperaturasMin,
          type: 'areaspline',
          yAxis: 0,
          color: '#3498db',
          fillColor: {
            linearGradient: { x1: 0, y1: 0, x2: 0, y2: 1 },
            stops: [
              [0, 'rgba(52, 152, 219, 0.3)'],
              [1, 'rgba(52, 152, 219, 0.1)'],
            ],
          },
          marker: {
            enabled: true,
            radius: 4,
            fillColor: '#3498db',
          },
        },
        {
          name: 'Humedad',
          data: humedades,
          type: 'spline',
          yAxis: 1,
          color: '#2ecc71',
          dashStyle: 'ShortDash',
          marker: {
            enabled: true,
            radius: 3,
            fillColor: '#2ecc71',
          },
        },
        {
          name: 'Precipitación',
          data: precipitaciones,
          type: 'column',
          yAxis: 2,
          color: '#9b59b6',
          pointWidth: 20,
          opacity: 0.7,
        },
      ],
      credits: {
        enabled: false,
      },
      plotOptions: {
        series: {
          animation: {
            duration: 1000,
            easing: 'easeOutQuart',
          },
        },
        column: {
          borderWidth: 0,
          borderRadius: 2,
        },
        areaspline: {
          lineWidth: 2,
        },
        spline: {
          lineWidth: 2,
        },
      },
      responsive: {
        rules: [
          {
            condition: {
              maxWidth: 768,
            },
            chartOptions: {
              chart: {
                height: 320,
                marginLeft: 35,
                marginRight: 35,
                marginTop: 15,
                marginBottom: 40,
                spacingTop: 10,
                spacingRight: 5,
                spacingBottom: 15,
                spacingLeft: 5,
                plotBackgroundColor: 'transparent',
              },
              title: {
                style: {
                  fontSize: '14px',
                },
              },
              subtitle: {
                style: {
                  fontSize: '11px',
                },
              },
              xAxis: {
                labels: {
                  style: {
                    fontSize: '10px',
                  },
                  rotation: 0,
                },
              },
              yAxis: [
                {
                  title: {
                    style: {
                      fontSize: '10px',
                    },
                  },
                  labels: {
                    style: {
                      fontSize: '10px',
                    },
                  },
                },
                {
                  title: {
                    style: {
                      fontSize: '10px',
                    },
                  },
                  labels: {
                    style: {
                      fontSize: '10px',
                    },
                  },
                },
                {
                  title: {
                    style: {
                      fontSize: '10px',
                    },
                  },
                  labels: {
                    style: {
                      fontSize: '10px',
                    },
                  },
                },
              ],
              legend: {
                itemStyle: {
                  fontSize: '10px',
                },
                margin: 10,
              },
              plotOptions: {
                column: {
                  pointWidth: 15,
                },
              },
            },
          },
        ],
      },
    };
  }

  // Métodos auxiliares para el resumen
  public getTemperatureRange(): string {
    if (this.pronosticosDias.length === 0) return '--';

    const temps = this.pronosticosDias.flatMap((dia) => [dia.tempMax, dia.tempMin]).filter((t) => t != null);
    const minTemp = Math.min(...temps);
    const maxTemp = Math.max(...temps);

    return `${minTemp}°C - ${maxTemp}°C`;
  }

  public getAverageHumidity(): number {
    if (this.pronosticosDias.length === 0) return 0;

    const humedades = this.pronosticosDias.map((dia) => dia.humedad).filter((h) => h != null);
    const promedio = humedades.reduce((sum, h) => sum + h, 0) / humedades.length;

    return Math.round(promedio);
  }

  public getTotalPrecipitation(): number {
    if (this.pronosticosDias.length === 0) return 0;

    const precipitaciones = this.pronosticosDias.map((dia) => dia.precipitacion || 0);
    const total = precipitaciones.reduce((sum, p) => sum + p, 0);

    return Math.round(total * 10) / 10; // Redondear a 1 decimal
  }

  // Métodos de formateo
  public formatearTemperatura(temp: number | null | undefined): string {
    return temp != null ? `${Math.round(temp)}°C` : '--';
  }

  public formatearHumedad(humedad: number | null | undefined): string {
    return humedad != null ? `${Math.round(humedad)}%` : '--';
  }

  public formatearViento(velocidad: number | null | undefined): string {
    return velocidad != null ? `${Math.round(velocidad)} km/h` : '--';
  }

  public formatearPresion(presion: number | null | undefined): string {
    return presion != null ? `${Math.round(presion)} hPa` : '--';
  }

  public formatearET0(et0: number | null | undefined): string {
    return et0 != null ? `${et0.toFixed(1)} mm` : '--';
  }

  public getIconUrl(iconNum: number | null | undefined): string {
    return iconNum ? `https://www.meteosource.com/static/img/ico/weather/${iconNum}.svg` : '';
  }
}
