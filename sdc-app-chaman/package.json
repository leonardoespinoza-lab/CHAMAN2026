{
  "name": "sdc-app-chaman",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "modelos": "npm install ../sdc-modelos --force",
    "extract": "ngx-translate-extract --input ./src --output ./public/i18n/en.json --format json --key-as-default-value & ngx-translate-extract --input ./src --output ./public/i18n/es.json --format json --key-as-default-value & ngx-translate-extract --input ./src --output ./public/i18n/br.json --format json --key-as-default-value",
    "build": "ng build --configuration production --output-path=dist --source-map=false",
    "build-test": "ng build --configuration test --output-path=dist --source-map=true",
    "lint": "ng lint",
    "ios:build": "./scripts/ios-build.sh",
    "ios:sync": "./scripts/ios-sync.sh",
    "ios:open": "npx cap open ios",
    "android:build": "./scripts/android-build.sh",
    "android:open": "npx cap open android",
    "ios:dev": "npm run build && npx cap sync ios && npx cap open ios",
    "ios:prod": "npm run build && npx cap sync ios && npx cap open ios",
    "android:dev": "npm run build && npx cap sync android && npx cap open android",
    "android:prod": "npm run build && npx cap sync android && npx cap open android",
    "cap:sync": "npx cap sync",
    "cap:sync:ios": "npx cap sync ios",
    "cap:sync:android": "npx cap sync android",
    "cap:clean": "npx cap clean-cache && rm -rf dist/",
    "cap:doctor": "npx cap doctor",
    "mobile:help": "cat MOBILE_BUILD.md"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.1.4",
    "@angular/cdk": "^20.1.4",
    "@angular/common": "^20.1.4",
    "@angular/compiler": "^20.1.4",
    "@angular/core": "^20.1.4",
    "@angular/forms": "^20.1.4",
    "@angular/platform-browser": "^20.1.4",
    "@angular/platform-browser-dynamic": "^20.1.4",
    "@angular/router": "^20.1.4",
    "@angular/service-worker": "^20.1.4",
    "@awesome-cordova-plugins/document-picker": "^8.1.0",
    "@capacitor-community/http": "^1.4.1",
    "@capacitor/android": "^7.2.0",
    "@capacitor/app": "^7.0.1",
    "@capacitor/core": "^7.2.0",
    "@capacitor/filesystem": "^7.1.4",
    "@capacitor/geolocation": "^7.1.4",
    "@capacitor/ios": "^7.2.0",
    "@capacitor/share": "^7.0.2",
    "@capawesome/capacitor-android-edge-to-edge-support": "^7.2.2",
    "@capgo/capacitor-social-login": "^7.6.3",
    "@ngx-translate/core": "^16.0.4",
    "@ngx-translate/http-loader": "^16.0.1",
    "@primeuix/themes": "^1.2.3",
    "chaman2026": "file:..",
    "chart.js": "^4.5.0",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "highcharts": "^11.4.8",
    "highcharts-angular": "^4.0.1",
    "jszip": "^3.10.1",
    "modelos": "file:../sdc-modelos",
    "ol": "^10.5.0",
    "primeicons": "^7.0.0",
    "primeng": "^20.0.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@angular/build": "^20.1.4",
    "@angular/cli": "^20.1.4",
    "@angular/compiler-cli": "^20.1.4",
    "@capacitor/cli": "^8.0.2",
    "@types/file-saver": "^2.0.7",
    "@types/jasmine": "~5.1.8",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "@vendure/ngx-translate-extract": "^9.4.0",
    "angular-eslint": "^20.1.1",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "jasmine-core": "~5.7.1",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "^3.5.3",
    "prettier-eslint": "^1.0.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "8.32.1"
  }
}
