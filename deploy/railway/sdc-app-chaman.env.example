# El frontend lee estas URLs en runtime desde /runtime-config.js.
CHAMAN_SERVICE=sdc-app-chaman
HOST=::
PORT=8080
CHAMAN_WEB_API_URL=https://${{chaman-api.RAILWAY_PUBLIC_DOMAIN}}/sdc-quimica
CHAMAN_WEB_WS_URL=
CHAMAN_WEB_TILES_URL=https://${{chaman-api.RAILWAY_PUBLIC_DOMAIN}}/sdc-quimica/data
# Must match COOKIE_AUTH_ENABLED in sdc-api-cliente for the same environment.
CHAMAN_COOKIE_AUTH_ENABLED=false
