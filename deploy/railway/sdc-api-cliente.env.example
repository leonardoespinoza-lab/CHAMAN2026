CHAMAN_SERVICE=sdc-api-cliente
ENV=production
HOST=::
PORT=5002
API_DATOS=http://${{chaman-datos.RAILWAY_PRIVATE_DOMAIN}}:${{chaman-datos.PORT}}
API_AUTH=http://${{chaman-auth.RAILWAY_PRIVATE_DOMAIN}}:${{chaman-auth.PORT}}/sdc-auth
API_PREDICCIONES=http://${{chaman-predicciones.RAILWAY_PRIVATE_DOMAIN}}:${{chaman-predicciones.PORT}}/sdc-predicciones
API_CLIMA=http://${{chaman-clima.RAILWAY_PRIVATE_DOMAIN}}:${{chaman-clima.PORT}}/clima
API_FTP=http://${{chaman-ftp.RAILWAY_PRIVATE_DOMAIN}}:${{chaman-ftp.PORT}}
TIMELAPSE_ADMIN_TOKEN=<shared-random-secret-with-sdc-ftp>
INTERNAL_HTTP_TIMEOUT_MS=30000
SOIL_INTELLIGENCE_INTERNAL_TOKEN=<shared-random-secret-with-sdc-datos>
AGROMETEO_INTERNAL_TOKEN=<shared-random-secret-with-sdc-datos-and-sdc-api-clima>
OPEN_METEO_API_KEY=<same-open-meteo-customer-api-key>
OPEN_METEO_FORECAST_BASE_URL=https://customer-api.open-meteo.com/v1
# Obligatorio en production: requiere un plan que habilite el historico customer.
# Solo testing/desarrollo puede omitirlo y usar el archive publico sin apikey.
OPEN_METEO_ARCHIVE_API_KEY=<open-meteo-professional-archive-api-key>
OPEN_METEO_ARCHIVE_BASE_URL=https://customer-archive-api.open-meteo.com/v1
OPEN_METEO_MAX_CONCURRENCY=2
OPEN_METEO_MIN_INTERVAL_MS=300
OPEN_METEO_TIMEOUT_MS=16000
OPEN_METEO_MAX_RETRIES=1
AUTH_CLIENT_ID=1
AUTH_CLIENT_SECRET=<same-as-sdc-auth-client-secret>
# Browser refresh-cookie mode. Keep both web and API flags aligned per environment.
COOKIE_AUTH_ENABLED=false
# Required only when COOKIE_AUTH_ENABLED=true; use an independent random value of 32+ characters.
SESSION_CSRF_SECRET=<random-secret-at-least-32-characters>
CACHE_WARM_LOGIN_DEDUPE_SECONDS=300
REDIS_HOST=${{Redis.REDISHOST}}
REDIS_PORT=${{Redis.REDISPORT}}
REDIS_PASSWORD=${{Redis.REDISPASSWORD}}
REDIS_DB=0
REDIS_NDVI_QUEUE=tareas-ndvi
REDIS_NDVI_DB=0
REDIS_DECISION_QUEUE=chaman-decision-v1
DECISION_PIPELINE_JOB_TIMEOUT_MS=300000
DECISION_PIPELINE_CONCURRENCY=4
MQTT_ENABLED=false
MQTT_PROTOCOL=ssl
MQTT_HOST=<mqtt-or-chirpstack-broker-host>
MQTT_PORT=8883
MQTT_USER=<mqtt-user>
MQTT_PASS=<mqtt-password>
MQTT_CLIENT_ID=chaman-api-production
MQTT_TOPIC_APIS=chaman-api-production
MAPS_KEY=
PREFIX=sdc-quimica
SWAGGER_ENABLED=false
CORS_ORIGINS=https://app.chamanagro.ar,https://chaman2026-production.up.railway.app,https://chamanagro.ar,https://www.chamanagro.ar
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_MS=60000
RBAC_DENY_UNDECORATED=false
GOOGLE_LOGIN_ENABLED=false
LOT_LOCATION_INTERNAL_TOKEN=<shared-random-secret-with-sdc-datos>
