CHAMAN_SERVICE=sdc-datos
ENV=production
HOST=::
PORT=5000
MONGO_URI=${{MongoDB.MONGO_URL}}
DB_NAME=chaman
DB_AUTO_INDEX_ENABLED=false
PREFIX_PATH=
SWAGGER_ENABLED=false
CORS_ORIGINS=https://app.chamanagro.ar,https://chaman2026-production.up.railway.app,https://chamanagro.ar,https://www.chamanagro.ar
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_MS=60000
LOT_LOCATION_INTERNAL_TOKEN=<shared-random-secret-with-sdc-api-cliente>
SOIL_INTELLIGENCE_INTERNAL_TOKEN=<shared-random-secret-with-sdc-api-cliente-clima-externa-predicciones>
AGROMETEO_INTERNAL_TOKEN=<shared-random-secret-with-sdc-api-clima>
LORAWAN_CATALOG_INTERNAL_TOKEN=<same-random-internal-token-as-sdc-api-lora>
OPEN_METEO_API_KEY=<same-open-meteo-customer-api-key>
OPEN_METEO_FORECAST_BASE_URL=https://customer-api.open-meteo.com/v1
# Opcional (plan Professional). Si queda vacio, production NO usa Archive
# publico: Forecast comercial cubre como maximo los ultimos 92 dias y los
# periodos anteriores sin serie canonica quedan marcados como incompletos.
OPEN_METEO_ARCHIVE_API_KEY=
OPEN_METEO_ARCHIVE_BASE_URL=
OPEN_METEO_MAX_CONCURRENCY=2
OPEN_METEO_MIN_INTERVAL_MS=300
OPEN_METEO_TIMEOUT_MS=12000
OPEN_METEO_MAX_RETRIES=1
GEOREF_SYNC_ENABLED=true
GEOREF_BASE_URL=https://apis.datos.gob.ar/georef/api/v2.0
GEOREF_SYNC_CRON=15 3 * * 0
GEOREF_SYNC_STARTUP_DELAY_MS=30000
GEOREF_SYNC_LOCK_TTL_MS=1800000
GEOREF_REQUEST_TIMEOUT_MS=120000
GEOREF_REQUEST_RETRIES=3
GEOREF_RETRY_BASE_DELAY_MS=1000
GEOREF_BACKFILL_LIMIT=0
GEOREF_LOCALITY_MAX_DISTANCE_METERS=100000
GEOREF_SETTLEMENT_MAX_DISTANCE_METERS=25000
LOT_LOCATION_RESOLVER_VERSION=lot-location-v1.0.0
CHAMAN_RUN_ACTIVE_INDEX_MIGRATION_ON_START=false
CHAMAN_ACTIVE_INDEX_MIGRATION_MODE=plan
