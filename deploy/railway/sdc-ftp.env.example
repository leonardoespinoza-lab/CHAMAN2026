CHAMAN_SERVICE=sdc-ftp
ENV=production
PORT=5000
API_DATOS=http://${{chaman-datos.RAILWAY_PRIVATE_DOMAIN}}:${{chaman-datos.PORT}}
PUBLIC_BASE_URL=https://chaman-ftp-production.up.railway.app
FTP_DATA_DIR=/data/chaman-timelapse
TIMELAPSE_ADMIN_TOKEN=

# FTP legacy/fallback
FTP_PORT=2121
FTP_ANONYMOUS=true
FTP_ALLOW_ACTIVE_BEHIND_PROXY=true

# Hik-Connect for Teams OpenAPI
HIKCONNECT_ENABLED=false
HIKCONNECT_SERVER_URL=
HIKCONNECT_APP_KEY=
HIKCONNECT_SECRET_KEY=
HIKCONNECT_DEFAULT_CHANNEL=1
HIKCONNECT_CAPTURE_ON_START=false
HIKCONNECT_CAPTURE_INTERVAL_MINUTES=0
