CHAMAN_SERVICE=sdc-api-clima
ENV=production
HOST=::
PORT=5008
API_DATOS=http://${{chaman-datos.RAILWAY_PRIVATE_DOMAIN}}:${{chaman-datos.PORT}}
SOIL_INTELLIGENCE_INTERNAL_TOKEN=<shared-random-secret-with-sdc-datos>
AGROMETEO_INTERNAL_TOKEN=<shared-random-secret-with-sdc-datos>
API_FIELD_CLIMATE=https://api.fieldclimate.com/v2
PUBLIC_KEY=<fieldclimate-public-key>
PRIVATE_KEY=<fieldclimate-private-key>
FIELD_CLIMATE_USERS=[]
FIELD_CLIMATE_PASS=[]
# Open-Meteo Forecast customer. Guardar claves solo como variables secretas
# de Railway, nunca en el repo.
OPEN_METEO_API_KEY=<open-meteo-customer-api-key>
OPEN_METEO_FORECAST_BASE_URL=https://customer-api.open-meteo.com/v1
# Obligatorio en production: requiere un plan que habilite el historico customer.
# Solo testing/desarrollo puede omitirlo y usar el archive publico sin apikey.
OPEN_METEO_ARCHIVE_API_KEY=<open-meteo-professional-archive-api-key>
OPEN_METEO_ARCHIVE_BASE_URL=https://customer-archive-api.open-meteo.com/v1
OPEN_METEO_MAX_CONCURRENCY=2
OPEN_METEO_MIN_INTERVAL_MS=300
OPEN_METEO_TIMEOUT_MS=12000
OPEN_METEO_MAX_RETRIES=1
OPEN_WEATHER_KEY=
METEO_SOURCE_KEY=
API_METEOBLUE=https://my.meteoblue.com/packages
METEOBLUE_API_KEY=
METEOBLUE_DAILY_PACKAGE=basic-day
METEOBLUE_HOURLY_PACKAGE=basic-1h
OMIXON_KEY=
API_HORATECH_APIKEY=
PREFIX=clima
SWAGGER_ENABLED=false
CORS_ORIGINS=https://app.chamanagro.ar,https://chaman2026-production.up.railway.app,https://chamanagro.ar,https://www.chamanagro.ar
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_MS=60000
