CHAMAN_SERVICE=sdc-auth
ENV=production
HOST=::
PORT=5001
API_DATOS=http://${{chaman-datos.RAILWAY_PRIVATE_DOMAIN}}:${{chaman-datos.PORT}}
AUTH_DATOS_TIMEOUT_MS=8000
CLIENT_ID_INICIAL=1
CLIENT_SECRET_INICIAL=<change-me>
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
PASSWORD_DEFAULT_GOOGLE=
GOOGLE_LOGIN_ENABLED=false
PREFIX=sdc-auth
SWAGGER_ENABLED=false
CORS_ORIGINS=https://app.chamanagro.ar,https://chaman2026-production.up.railway.app,https://chamanagro.ar,https://www.chamanagro.ar
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_MS=60000
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=28800
LOGIN_ATTEMPTS_MAX_ENTRIES=10000
