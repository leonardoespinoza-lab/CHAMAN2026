CHAMAN_SERVICE=sdc-api-lora
ENV=production
HOST=::
PORT=5012
API_DATOS=http://${{chaman-datos.RAILWAY_PRIVATE_DOMAIN}}:${{chaman-datos.PORT}}
PREFIX=

# API key used by legacy ChirpStack webhook endpoints.
APIKEY_CHIRPSTACK=<chirpstack-webhook-api-key>

# EMQX / LoRaWAN MQTT consumer.
LORAWAN_MQTT_ENABLED=true
LORAWAN_MQTT_URL=mqtts://<emqx-host>:8883
LORAWAN_MQTT_USERNAME=<mqtt-user>
LORAWAN_MQTT_PASSWORD=<mqtt-password>
LORAWAN_MQTT_CLIENT_ID=chaman-lorawan-production
LORAWAN_MQTT_TOPICS=application/+/device/+/rx
LORAWAN_MQTT_QOS=0

# Optional secondary ChirpStack broker, useful for legacy fruit/cold-hour projects.
LORAWAN_MQTT_SECONDARY_URL=mqtt://lora.chamanagro.ar:1883
LORAWAN_MQTT_SECONDARY_TOPICS=application/+/device/+/event/up
LORAWAN_MQTT_SECONDARY_USERNAME=
LORAWAN_MQTT_SECONDARY_PASSWORD=
LORAWAN_MQTT_SECONDARY_CLIENT_ID=chaman-lorawan-legacy-frutales

SWAGGER_ENABLED=false
CORS_ORIGINS=https://app.chamanagro.ar,https://chaman2026-production.up.railway.app,https://chamanagro.ar,https://www.chamanagro.ar
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_MS=60000
